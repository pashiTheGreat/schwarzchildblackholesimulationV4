#version 430
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) writeonly uniform image2D outImage;
layout(std140, binding = 1) uniform Camera {
    vec3 camPos;     float _pad0;
    vec3 camRight;   float _pad1;
    vec3 camUp;      float _pad2;
    vec3 camForward; float _pad3;
    float tanHalfFov;
    float aspect;
    int moving;
    int   _pad4;
} cam;

layout(std140, binding = 2) uniform Disk {
    float disk_r1;
    float disk_r2;
    float disk_inclination;
    float thickness;
    float disk_time;
    float disk_accretion_rate;
    float disk_detail_strength;
    float _disk_pad;
    float disk_temperature_scale;
    float disk_rotation_sign;
    int disk_visible;
    int _disk_pad2;
};

// All coordinates and affine steps below are dimensionless Schwarzschild
// units: r_s = 1 and lambda_dimensionless = lambda_SI / r_s.  The C++ app
// normalizes all distances before uploading them, so vacuum lensing contains
// no hidden Sagittarius A* mass constant.
layout(std140, binding = 4) uniform Integration {
    float minimumStep;
    float maximumStep;
    float captureRadius;
    float escapeRadius;
    float absoluteTolerance;
    float relativeTolerance;
    int maximumSteps;
    int renderMode;
    int validationOverlay;
    int backgroundMode;
    int exportDiagnostics;
    int temperatureValidation;
} integration;

// One atomic classification per output pixel.  Statuses are intentionally
// distinct: numerical failures and exhausted budgets must never enlarge the
// event-horizon silhouette.
const int STATUS_CAPTURED = 0;
const int STATUS_ESCAPED = 1;
const int STATUS_DISK_HIT = 2;
// Slot 3 remains reserved so historical six-counter reports retain their ABI.
const int STATUS_UNRESOLVED = 4;
const int STATUS_INVALID = 5;
layout(std430, binding = 5) buffer RayDiagnostics {
    uint rayStatusCounts[6];
};
layout(std430, binding = 6) buffer RayStatusPixels {
    uint rayStatusPixels[];
};
struct ValidationInvariants {
    vec4 initial; // null norm, E, L^2, L_z
    vec4 final;   // null norm, E, L^2, final r
};
layout(std430, binding = 7) buffer RayInvariantPixels {
    ValidationInvariants rayInvariantPixels[];
};

struct Ray {
    float x, y, z, r, theta, phi;
    float dt, dr, dtheta, dphi;
    float E, L2, Lz;
    bool validCoordinates;
};

// Procedural deep-space background. It is sampled with the ray's final
// direction, after geodesic integration, so the stars bend around the hole.
float hash31(vec3 p) {
    p = fract(p * 0.1031);
    p += dot(p, p.yzx + 33.33);
    return fract((p.x + p.y) * p.z);
}

vec3 hash33(vec3 p) {
    return vec3(
        hash31(p + vec3(17.0, 59.4, 15.0)),
        hash31(p + vec3(91.0, 11.7, 47.0)),
        hash31(p + vec3(37.0, 83.2, 73.0))
    );
}

float valueNoise(vec3 p) {
    vec3 cell = floor(p);
    vec3 local = fract(p);
    local = local * local * (3.0 - 2.0 * local);

    float n000 = hash31(cell + vec3(0, 0, 0));
    float n100 = hash31(cell + vec3(1, 0, 0));
    float n010 = hash31(cell + vec3(0, 1, 0));
    float n110 = hash31(cell + vec3(1, 1, 0));
    float n001 = hash31(cell + vec3(0, 0, 1));
    float n101 = hash31(cell + vec3(1, 0, 1));
    float n011 = hash31(cell + vec3(0, 1, 1));
    float n111 = hash31(cell + vec3(1, 1, 1));

    float nx00 = mix(n000, n100, local.x);
    float nx10 = mix(n010, n110, local.x);
    float nx01 = mix(n001, n101, local.x);
    float nx11 = mix(n011, n111, local.x);
    return mix(mix(nx00, nx10, local.y), mix(nx01, nx11, local.y), local.z);
}

float fbm(vec3 p) {
    float value = 0.0;
    float amplitude = 0.5;
    for (int octave = 0; octave < 4; ++octave) {
        value += amplitude * valueNoise(p);
        p = p * 2.03 + vec3(13.1, 7.7, 19.3);
        amplitude *= 0.5;
    }
    return value;
}

float ridgedFbm(vec3 p) {
    float value = 0.0;
    float amplitude = 0.55;
    for (int octave = 0; octave < 5; ++octave) {
        float ridge = 1.0 - abs(2.0 * valueNoise(p) - 1.0);
        value += ridge * ridge * amplitude;
        p = p * 2.11 + vec3(5.7, 17.3, 11.9);
        amplitude *= 0.48;
    }
    return value;
}

vec3 starLayer(vec2 uv, float scale, float density) {
    vec2 grid = uv * scale;
    vec2 cell = floor(grid);
    vec2 local = fract(grid) - 0.5;
    vec3 seed = vec3(cell, scale);
    vec3 randomValues = hash33(seed);

    vec2 starOffset = (randomValues.xy - 0.5) * 0.72;
    vec2 starLocal = local - starOffset;
    float distanceToStar = length(starLocal);
    float exists = step(density, randomValues.z);
    float radius = mix(0.055, 0.16, hash31(seed + 8.0));
    float core = 1.0 - smoothstep(radius * 0.18, radius, distanceToStar);
    float glow = exp(-distanceToStar * 22.0) * 0.24;

    float rareBrightStar = step(0.965, hash31(seed + 67.0));
    float horizontalRay = exp(-abs(starLocal.x) * 85.0);
    float verticalRay = exp(-abs(starLocal.y) * 85.0);
    float diffraction = (horizontalRay + verticalRay)
                      * exp(-distanceToStar * 9.0) * rareBrightStar * 0.32;

    float temperature = hash31(seed + 21.0);
    vec3 warm = vec3(1.0, 0.62, 0.32);
    vec3 neutral = vec3(1.0, 0.94, 0.82);
    vec3 blue = vec3(0.55, 0.72, 1.0);
    vec3 starColor = temperature < 0.32
        ? mix(warm, neutral, temperature / 0.32)
        : mix(neutral, blue, (temperature - 0.32) / 0.68);
    float brightness = mix(0.55, 3.2, hash31(seed + 41.0));
    return starColor * exists * (core + glow + diffraction) * brightness;
}

vec3 spaceBackground(vec3 direction) {
    vec3 d = normalize(direction);
    const float PI = 3.14159265359;
    vec2 skyUv = vec2(atan(d.z, d.x) / (2.0 * PI) + 0.5,
                      asin(clamp(d.y, -1.0, 1.0)) / PI + 0.5);

    vec3 galaxyNormal = normalize(vec3(0.23, 0.91, -0.34));
    float largeClouds = fbm(d * 4.2 + vec3(2.0, 8.0, 1.0));
    float warpedLatitude = dot(d, galaxyNormal)
                         + (largeClouds - 0.5) * 0.105;
    float latitude = abs(warpedLatitude);
    float broadBand = exp(-latitude * 4.8);
    float denseBand = exp(-latitude * 15.5);

    float cloudDetail = fbm(d * 10.0 - vec3(7.0, 3.0, 9.0));
    float filamentDetail = ridgedFbm(d * 15.0 + vec3(4.0, 12.0, 6.0));
    float dustNoise = fbm(d * 24.0 - vec3(13.0, 2.0, 17.0));
    float dustLane = denseBand * smoothstep(0.48, 0.77, dustNoise)
                   * (0.45 + 0.55 * filamentDetail);

    vec3 approximateCore = vec3(-0.72, 0.08, 0.69);
    vec3 coreDirection = normalize(
        approximateCore - galaxyNormal * dot(approximateCore, galaxyNormal));
    float coreAlignment = pow(max(dot(d, coreDirection), 0.0), 7.0);
    float warmCore = denseBand * coreAlignment
                   * (0.45 + 0.85 * filamentDetail);

    vec3 color = vec3(0.0012, 0.0022, 0.012);
    color += vec3(0.004, 0.008, 0.026) * (0.5 + 0.5 * d.y);
    color += vec3(0.018, 0.030, 0.105) * broadBand
           * (0.32 + 0.88 * largeClouds);
    color += vec3(0.075, 0.055, 0.19) * denseBand
           * (0.25 + 0.75 * cloudDetail);
    color += vec3(0.10, 0.11, 0.24) * denseBand
           * pow(clamp(filamentDetail, 0.0, 1.4), 2.0);
    color += vec3(0.34, 0.14, 0.105) * warmCore;

    // Dark molecular clouds break up the galactic band like the reference.
    color *= 1.0 - clamp(dustLane * 0.72, 0.0, 0.78);

    vec3 stars = vec3(0.0);
    stars += starLayer(skyUv, 82.0, 0.84);
    stars += starLayer(skyUv + vec2(0.173, 0.291), 175.0, 0.91);
    stars += starLayer(skyUv + vec2(0.417, 0.113), 330.0, 0.963);
    float galacticStarDensity = mix(0.989, 0.945,
        clamp(denseBand * (0.35 + largeClouds), 0.0, 1.0));
    stars += starLayer(skyUv + vec2(0.713, 0.537), 540.0, galacticStarDensity);
    color += stars * (1.0 - clamp(dustLane * 0.58, 0.0, 0.7));
    return color;
}

vec3 diskNormal() {
    // Tilt the original Y-up disk around the Z axis. This keeps the default
    // camera outside the finite disk slab instead of embedded inside it.
    return normalize(vec3(sin(disk_inclination), cos(disk_inclination), 0.0));
}

bool intersectAccretionDisk(vec3 oldPos, vec3 newPos, out vec3 hitPosition) {
    if (disk_visible == 0) return false;
    vec3 normal = diskNormal();
    float oldHeight = dot(oldPos, normal);
    float newHeight = dot(newPos, normal);
    // `thickness` is uploaded as a half-thickness in dimensionless
    // Schwarzschild radii (r_s = 1). Keep only a numerical epsilon here;
    // applying a 1.0 r_s floor would erase the configured 0.02-0.75 range.
    float halfThickness = max(thickness, 1e-4);

    bool enteredSlab = abs(newHeight) <= halfThickness;
    bool crossedMidplane = oldHeight * newHeight <= 0.0;
    if (!enteredSlab && !crossedMidplane) return false;

    float interpolation = 1.0;
    float heightDelta = oldHeight - newHeight;
    if (abs(heightDelta) > 1e-5) {
        if (abs(oldHeight) > halfThickness && enteredSlab) {
            float boundary = sign(oldHeight) * halfThickness;
            interpolation = (oldHeight - boundary) / heightDelta;
        } else if (crossedMidplane) {
            interpolation = oldHeight / heightDelta;
        }
    }

    hitPosition = mix(oldPos, newPos, clamp(interpolation, 0.0, 1.0));
    vec3 radialVector = hitPosition - normal * dot(hitPosition, normal);
    float diskRadius = length(radialVector);
    return diskRadius >= disk_r1 && diskRadius <= disk_r2;
}

vec3 blackbodyColor(float temperatureKelvin) {
    // Fast approximation of a blackbody radiator in display RGB.
    float temperature = clamp(temperatureKelvin, 1000.0, 40000.0) / 100.0;
    float red = temperature <= 66.0
        ? 1.0
        : clamp(1.292936 * pow(temperature - 60.0, -0.133205), 0.0, 1.0);
    float green = temperature <= 66.0
        ? clamp(0.390082 * log(temperature) - 0.631841, 0.0, 1.0)
        : clamp(1.129891 * pow(temperature - 60.0, -0.075515), 0.0, 1.0);
    float blue = temperature >= 66.0
        ? 1.0
        : (temperature <= 19.0
            ? 0.0
            : clamp(0.543207 * log(temperature - 10.0) - 1.196254, 0.0, 1.0));
    return vec3(red, green, blue);
}

float thinDiskNoTorqueBoundary(float radius) {
    float safeRadius = max(radius, disk_r1);
    return max(1.0 - sqrt(disk_r1 / safeRadius), 0.0);
}

float thinDiskPhysicalFluxShape(float radius) {
    float safeRadius = max(radius, disk_r1);
    float noTorqueBoundary = thinDiskNoTorqueBoundary(safeRadius);
    return noTorqueBoundary / (safeRadius * safeRadius * safeRadius);
}

float thinDiskDisplayFluxProfile(float radius) {
    float normalizedRadius = max(radius / disk_r1, 1.0001);
    float noTorqueBoundary = thinDiskNoTorqueBoundary(radius);
    return noTorqueBoundary /
        (normalizedRadius * normalizedRadius * normalizedRadius);
}

float thinDiskLocalTemperature(float radius) {
    float physicalFluxShape = thinDiskPhysicalFluxShape(radius);
    return disk_temperature_scale * pow(max(physicalFluxShape, 0.0), 0.25);
}

float diskObservedFrequencyShift(
    float radius,
    float photonEnergy,
    float axisAngularMomentum
) {
    float omega = sqrt(1.0 / (2.0 * radius * radius * radius));
    float emitterUt = inversesqrt(max(1.0 - 1.5 / radius, 1e-5));
    float observerUt = inversesqrt(max(1.0 - 1.0 / length(cam.camPos), 1e-5));
    float observerFrequency = photonEnergy * observerUt;
    float emitterFrequency = emitterUt *
        (photonEnergy - disk_rotation_sign * omega * axisAngularMomentum);
    return clamp(observerFrequency / max(emitterFrequency, 1e-6), 0.05, 4.0);
}

vec3 shadeAccretionDisk(
    vec3 hitPosition,
    Ray ray,
    float angularTravel,
    float affineDistance
) {
    vec3 normal = diskNormal();
    vec3 radialVector = hitPosition - normal * dot(hitPosition, normal);
    float radius = max(length(radialVector), disk_r1);
    vec3 radialDirection = radialVector / radius;
    vec3 orbitalDirection = normalize(cross(normal, radialDirection));

    float radialPosition = clamp(
        (radius - disk_r1) / (disk_r2 - disk_r1), 0.0, 1.0);
    float edgeFade = smoothstep(0.0, 0.06, radialPosition)
                   * (1.0 - smoothstep(0.82, 1.0, radialPosition));

    // Build stable coordinates in the inclined disk plane. Texture features
    // are advected at a radius-dependent Keplerian angular speed, producing
    // differential rotation and natural spiral shear rather than sliding the
    // entire texture as one rigid surface.
    vec3 diskAxisU = normalize(cross(normal, vec3(0.0, 0.0, 1.0)));
    vec3 diskAxisV = normalize(cross(normal, diskAxisU));
    float azimuth = atan(dot(radialDirection, diskAxisV),
                         dot(radialDirection, diskAxisU));
    float radiusInSchwarzschildUnits = radius;
    float keplerianAngularSpeed = 0.72 /
        pow(max(radiusInSchwarzschildUnits, 1.0), 1.5);
    float advectedAzimuth = azimuth - disk_rotation_sign *
        disk_time * keplerianAngularSpeed;

    float logarithmicRadius = log(max(radius / disk_r1, 1.0001));
    vec3 flowCoordinates = vec3(
        cos(advectedAzimuth) * radiusInSchwarzschildUnits,
        sin(advectedAzimuth) * radiusInSchwarzschildUnits,
        logarithmicRadius * 4.0);
    float broadTurbulence = fbm(flowCoordinates * 2.8 + vec3(2.0, 9.0, 4.0));
    float fineFilaments = ridgedFbm(
        flowCoordinates * 7.5 + vec3(13.0, 3.0, disk_time * 0.025));
    float spiralPhase = advectedAzimuth * 7.0 - logarithmicRadius * 19.0;
    float spiralArm = pow(0.5 + 0.5 * sin(spiralPhase), 4.0);
    float fineRings = pow(0.5 + 0.5 * sin(
        radiusInSchwarzschildUnits * 54.0
        + broadTurbulence * 7.0 - advectedAzimuth * 2.0), 7.0);
    float darkClumps = smoothstep(0.58, 0.82, valueNoise(
        flowCoordinates * 11.0 - vec3(4.0, disk_time * 0.018, 7.0)));

    float surfaceDensity = 0.48
        + 0.48 * broadTurbulence
        + 0.58 * fineFilaments
        + 0.48 * spiralArm
        + 0.34 * fineRings;
    surfaceDensity *= 1.0 - 0.58 * darkClumps;
    surfaceDensity = mix(1.0, surfaceDensity, disk_detail_strength);
    surfaceDensity = clamp(surfaceDensity, 0.18, 2.35);

    // Keep display exposure separate from the physical dimensionless flux
    // shape. The latter uses radius in r_s units because C++ has already put
    // the r_s^-3 factor into disk_temperature_scale.
    float displayFluxProfile = thinDiskDisplayFluxProfile(radius);
    float displayExposure = clamp(displayFluxProfile / 0.05665, 0.0, 1.35);

    // Frequency shift from four-vectors.  With k_t=-E and a circular emitter
    // u^mu=u^t(1,0,0,Omega), -k.u_emit=u^t(E-Omega*L_axis).
    // The angular-momentum projection works for any disk plane because the
    // Schwarzschild geometry is spherically symmetric.
    float sinTheta = sin(ray.theta);
    vec3 photonVelocity = vec3(
        ray.dr * sinTheta * cos(ray.phi) +
            ray.r * cos(ray.theta) * ray.dtheta * cos(ray.phi) -
            ray.r * sinTheta * sin(ray.phi) * ray.dphi,
        ray.dr * cos(ray.theta) - ray.r * sinTheta * ray.dtheta,
        ray.dr * sinTheta * sin(ray.phi) +
            ray.r * cos(ray.theta) * ray.dtheta * sin(ray.phi) +
            ray.r * sinTheta * cos(ray.phi) * ray.dphi);
    vec3 angularMomentum = cross(vec3(ray.x, ray.y, ray.z), photonVelocity);
    float axisAngularMomentum = dot(angularMomentum, normal);
    float observedShift = diskObservedFrequencyShift(
        radius, ray.E, axisAngularMomentum);

    float localTemperature = thinDiskLocalTemperature(radius);

    // Keep the disk in a cinematic orange range while letting the frequency
    // shift move the approaching side toward gold and the receding side
    // toward deep red-orange. Relativistic intensity is applied below.
    float thermalPosition = clamp(
        (localTemperature - 2300.0) / (14200.0 - 2300.0), 0.0, 1.0);
    vec3 deepOrange = vec3(0.52, 0.022, 0.0015);
    vec3 hotOrange = vec3(1.00, 0.42, 0.035);
    vec3 approachingGold = vec3(1.00, 0.68, 0.19);
    vec3 cinematicColor = mix(deepOrange, hotOrange, pow(thermalPosition, 0.72));

    float blueShiftAmount = smoothstep(1.0, 1.85, observedShift);
    float redShiftAmount = smoothstep(0.0, 0.62, 1.0 - observedShift);
    cinematicColor = mix(cinematicColor, approachingGold, blueShiftAmount * 0.62);
    cinematicColor = mix(cinematicColor, deepOrange, redShiftAmount * 0.72);
    vec3 physicalColor = blackbodyColor(localTemperature * observedShift);

    // Liouville's theorem gives a fourth-power bolometric intensity shift.
    float relativisticBeaming = pow(observedShift, 4.0);
    if (integration.renderMode == 0) {
        // Bolometric rendering: I_obs = g^4 I_emit. displayExposure preserves
        // the prior image exposure profile; physicalFluxShape alone controls
        // local temperature. Procedural density changes emissivity, not rays.
        float physicalIntensity = edgeFade * displayExposure * surfaceDensity *
                                  relativisticBeaming;
        return physicalColor * physicalIntensity;
    }
    float cinematicHigherOrderBoost = 1.0 +
        0.82 * smoothstep(1.9, 5.8, angularTravel);
    float cinematicIntensity = edgeFade * displayExposure * surfaceDensity *
        relativisticBeaming * cinematicHigherOrderBoost *
        disk_accretion_rate * 3.2;
    return cinematicColor * cinematicIntensity;
}

vec3 photonRingEmission(float closestRadius, float angularTravel) {
    float distanceFromPhotonSphere =
        (closestRadius - 1.5) / 0.078;
    float criticalProximity = exp(-distanceFromPhotonSphere * distanceFromPhotonSphere);
    float windingBoost = mix(0.22, 2.65, smoothstep(1.0, 5.2, angularTravel));
    return vec3(1.0, 0.60, 0.18) * criticalProximity * windingBoost;
}

vec3 acesToneMap(vec3 color) {
    const float a = 2.51;
    const float b = 0.03;
    const float c = 2.43;
    const float d = 0.59;
    const float e = 0.14;
    // Apply the filmic curve to peak luminance and rescale all channels
    // together. Per-channel tone mapping turns intense orange into white;
    // this hue-preserving form keeps relativistic highlights orange/gold.
    float peak = max(max(color.r, color.g), max(color.b, 1e-6));
    float mappedPeak = clamp(
        (peak * (a * peak + b)) / (peak * (c * peak + d) + e),
        0.0, 1.0);
    return clamp(color * (mappedPeak / peak), 0.0, 1.0);
}

// CPU reference: physics/schwarzschild.cpp,
// initialize_static_observer_photon().  Both implementations use the Y-up
// convention x=r sin(theta) cos(phi), y=r cos(theta), z=r sin(theta) sin(phi)
// and r_s-scaled geometrized units.  A ray supplied by the screen is a local
// static-observer measurement, never a raw coordinate derivative.
Ray initRay(vec3 pos, vec3 dir) {
    Ray ray;
    ray.x = pos.x; ray.y = pos.y; ray.z = pos.z;
    ray.r = length(pos);
    // Y is the polar/up axis, so theta = PI/2 is the x-z disk plane.
    ray.theta = acos(clamp(pos.y / ray.r, -1.0, 1.0));
    ray.phi = atan(pos.z, pos.x);

    const float sinTheta = sin(ray.theta);
    const float f = 1.0 - 1.0 / ray.r;
    ray.validCoordinates = ray.r > 1.0 && f > 0.0 &&
                           abs(sinTheta) >= 1e-5;
    if (!ray.validCoordinates) {
        ray.dt = ray.dr = ray.dtheta = ray.dphi = 0.0;
        ray.E = ray.L2 = ray.Lz = 0.0;
        return ray;
    }

    // Project the normalized screen direction into the observer's local
    // spherical orthonormal frame (e_r, e_theta, e_phi).
    const vec3 screenDirection = normalize(dir);
    const vec3 eR = vec3(sinTheta * cos(ray.phi),
                          cos(ray.theta),
                          sinTheta * sin(ray.phi));
    const vec3 eTheta = vec3(cos(ray.theta) * cos(ray.phi),
                              -sinTheta,
                              cos(ray.theta) * sin(ray.phi));
    const vec3 ePhi = vec3(-sin(ray.phi), 0.0, cos(ray.phi));
    const float nR = dot(screenDirection, eR);
    const float nTheta = dot(screenDirection, eTheta);
    const float nPhi = dot(screenDirection, ePhi);

    // Static-observer tetrad initialization, with arbitrary E_local = 1:
    // k^t=E_local/sqrt(f), k^r=E_local sqrt(f)n_r,
    // k^theta=E_local n_theta/r, k^phi=E_local n_phi/(r sin(theta)).
    const float localEnergy = 1.0;
    const float sqrtF = sqrt(f);
    ray.dt = localEnergy / sqrtF;
    ray.dr = localEnergy * sqrtF * nR;
    ray.dtheta = localEnergy * nTheta / ray.r;
    ray.dphi = localEnergy * nPhi / (ray.r * sinTheta);
    ray.E = f * ray.dt;
    ray.L2 = ray.r * ray.r * ray.r * ray.r *
        (ray.dtheta * ray.dtheta + sinTheta * sinTheta * ray.dphi * ray.dphi);
    ray.Lz = ray.r * ray.r * sinTheta * sinTheta * ray.dphi;

    return ray;
}

bool intercept(Ray ray, float rs) {
    return ray.r <= rs;
}
void geodesicRHS(Ray ray, out vec3 d1, out vec3 d2) {
    float r = ray.r, theta = ray.theta;
    float dr = ray.dr, dtheta = ray.dtheta, dphi = ray.dphi;
    float sinTheta = max(sin(theta), 1e-6);
    d1 = vec3(dr, dtheta, dphi);
    // The direct coordinate equation is
    // r''=-f(k^t)^2/(2r^2)+(k^r)^2/(2r^2f)
    //     +r*f*((k^theta)^2+sin^2(theta)*(k^phi)^2).
    // Substituting the null constraint and conserved total L^2 gives the
    // algebraically identical form below.  It avoids catastrophic float
    // cancellation between the first two terms close to the horizon.
    d2.x = ray.L2 * (r - 1.5) / (r * r * r * r);
    d2.y = -2.0*dr*dtheta/r + sinTheta*cos(theta)*dphi*dphi;
    d2.z = -2.0*dr*dphi/r - 2.0*cos(theta)/sinTheta * dtheta * dphi;
}

Ray offsetRay(Ray base, vec3 positionDerivative, vec3 velocityDerivative, float scale) {
    Ray result = base;
    result.r      += positionDerivative.x * scale;
    result.theta  += positionDerivative.y * scale;
    result.phi    += positionDerivative.z * scale;
    result.dr     += velocityDerivative.x * scale;
    result.dtheta += velocityDerivative.y * scale;
    result.dphi   += velocityDerivative.z * scale;
    return result;
}

void rk4Step(inout Ray ray, float dL) {
    Ray base = ray;
    vec3 k1a, k1b, k2a, k2b, k3a, k3b, k4a, k4b;
    geodesicRHS(base, k1a, k1b);

    Ray stage2 = offsetRay(base, k1a, k1b, dL * 0.5);
    geodesicRHS(stage2, k2a, k2b);

    Ray stage3 = offsetRay(base, k2a, k2b, dL * 0.5);
    geodesicRHS(stage3, k3a, k3b);

    Ray stage4 = offsetRay(base, k3a, k3b, dL);
    geodesicRHS(stage4, k4a, k4b);

    vec3 positionDelta = (k1a + 2.0*k2a + 2.0*k3a + k4a) * (dL / 6.0);
    vec3 velocityDelta = (k1b + 2.0*k2b + 2.0*k3b + k4b) * (dL / 6.0);

    ray.r      = base.r + positionDelta.x;
    ray.theta  = base.theta + positionDelta.y;
    ray.phi    = base.phi + positionDelta.z;
    ray.dr     = base.dr + velocityDelta.x;
    ray.dtheta = base.dtheta + velocityDelta.y;
    ray.dphi   = base.dphi + velocityDelta.z;
    ray.dt = ray.E / max(1.0 - 1.0 / ray.r, 1e-6);
    ray.x = ray.r * sin(ray.theta) * cos(ray.phi);
    ray.y = ray.r * cos(ray.theta);
    ray.z = ray.r * sin(ray.theta) * sin(ray.phi);
}

bool rayIsFinite(Ray ray) {
    return !(isnan(ray.r) || isinf(ray.r) || isnan(ray.theta) ||
             isinf(ray.theta) || isnan(ray.phi) || isinf(ray.phi) ||
             isnan(ray.dr) || isinf(ray.dr) || isnan(ray.dtheta) ||
             isinf(ray.dtheta) || isnan(ray.dphi) || isinf(ray.dphi));
}

vec4 rayInvariants(Ray ray) {
    float f = max(1.0 - 1.0 / ray.r, 1e-8);
    float sinTheta = sin(ray.theta);
    float angular = ray.dtheta * ray.dtheta +
                    sinTheta * sinTheta * ray.dphi * ray.dphi;
    float nullValue = -f * ray.dt * ray.dt + ray.dr * ray.dr / f +
                      ray.r * ray.r * angular;
    float l2 = ray.r * ray.r * ray.r * ray.r * angular;
    float lz = ray.r * ray.r * sinTheta * sinTheta * ray.dphi;
    return vec4(nullValue, ray.E, l2, lz);
}

float componentError(float whole, float fine) {
    float scale = integration.absoluteTolerance + integration.relativeTolerance *
        max(abs(whole), abs(fine));
    return abs(whole - fine) / max(scale, 1e-12);
}

float stepDoublingError(Ray whole, Ray fine) {
    float error = 0.0;
    error = max(error, componentError(whole.r, fine.r));
    error = max(error, componentError(whole.theta, fine.theta));
    error = max(error, componentError(whole.phi, fine.phi));
    error = max(error, componentError(whole.dr, fine.dr));
    error = max(error, componentError(whole.dtheta, fine.dtheta));
    error = max(error, componentError(whole.dphi, fine.dphi));
    return error / 15.0;
}

// Returns false only when the ray cannot meet configured error bounds.  The
// accepted fine state is retained; RK4 step-doubling is robust on GPU drivers
// without an embedded RK pair.
bool adaptiveRK4Step(inout Ray ray, inout float suggestedStep,
                     out float acceptedStep) {
    float step = suggestedStep;
    for (int attempt = 0; attempt < 10; ++attempt) {
        Ray whole = ray;
        rk4Step(whole, step);
        Ray fine = ray;
        rk4Step(fine, step * 0.5);
        rk4Step(fine, step * 0.5);
        if (!rayIsFinite(whole) || !rayIsFinite(fine)) {
            step *= 0.25;
        } else if (fine.r <= integration.captureRadius) {
            // The horizon event is bracketed by the previous and fine states;
            // main() interpolates that crossing before classifying capture.
            ray = fine;
            acceptedStep = step;
            return true;
        } else {
            float error = stepDoublingError(whole, fine);
            if (error <= 1.0) {
                ray = fine;
                acceptedStep = step;
                float growth = error <= 1e-8 ? 2.0 :
                    clamp(0.9 * pow(1.0 / error, 0.2), 0.2, 2.0);
                suggestedStep = clamp(step * growth, integration.minimumStep,
                                      integration.maximumStep);
                return true;
            }
            step *= clamp(0.9 * pow(1.0 / error, 0.2), 0.1, 0.5);
        }
        if (step < integration.minimumStep) {
            return false;
        }
    }
    return false;
}

bool interpolateHorizonCrossing(Ray previous, Ray current, float radius,
                                out Ray crossing) {
    if (!(previous.r > radius && current.r <= radius)) return false;
    float fraction = clamp((previous.r - radius) /
                           max(previous.r - current.r, 1e-8), 0.0, 1.0);
    crossing = previous;
    crossing.r = mix(previous.r, current.r, fraction);
    crossing.theta = mix(previous.theta, current.theta, fraction);
    crossing.phi = mix(previous.phi, current.phi, fraction);
    crossing.dr = mix(previous.dr, current.dr, fraction);
    crossing.dtheta = mix(previous.dtheta, current.dtheta, fraction);
    crossing.dphi = mix(previous.dphi, current.dphi, fraction);
    crossing.dt = mix(previous.dt, current.dt, fraction);
    crossing.x = crossing.r * sin(crossing.theta) * cos(crossing.phi);
    crossing.y = crossing.r * cos(crossing.theta);
    crossing.z = crossing.r * sin(crossing.theta) * sin(crossing.phi);
    return true;
}

float adaptiveStepSize(Ray ray) {
    // Geometry supplies only a safe upper bound; step-doubling supplies the
    // actual local-error control.  A quadratic curvature scale avoids the old
    // radius interpolation that forced thousands of minimum-size steps.
    float curvatureStep = clamp(0.02 * ray.r * ray.r,
                                integration.minimumStep,
                                integration.maximumStep);
    // Prevent a single inward step from jumping far beyond the configured
    // capture event surface.
    float horizonDistance = max(ray.r - integration.captureRadius,
                                integration.minimumStep);
    float inwardSpeed = max(abs(ray.dr), 0.25);
    float horizonSafeStep = horizonDistance * 0.25 / inwardSpeed;
    return clamp(min(curvatureStep, horizonSafeStep), integration.minimumStep,
                 integration.maximumStep);
}
void main() {
    ivec2 imageDimensions = imageSize(outImage);
    int WIDTH = imageDimensions.x;
    int HEIGHT = imageDimensions.y;

    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= WIDTH || pix.y >= HEIGHT) return;
    int pixelIndex = pix.y * WIDTH + pix.x;

    if (integration.temperatureValidation != 0) {
        float radius = pixelIndex == 0 ? 3.5
                     : pixelIndex == 1 ? 4.5
                     : pixelIndex == 2 ? 6.0
                     : pixelIndex == 3 ? 9.0
                                       : 12.0;
        float localTemperature = thinDiskLocalTemperature(radius);
        float physicalFluxShape = thinDiskPhysicalFluxShape(radius);
        float displayFluxProfile = thinDiskDisplayFluxProfile(radius);
        float positiveAngularMomentumShift = diskObservedFrequencyShift(
            radius, 0.9, 2.1);
        float negativeAngularMomentumShift = diskObservedFrequencyShift(
            radius, 0.9, -2.1);
        atomicAdd(rayStatusCounts[STATUS_DISK_HIT], 1u);
        rayStatusPixels[pixelIndex] = uint(STATUS_DISK_HIT);
        rayInvariantPixels[pixelIndex].initial = vec4(
            radius, localTemperature, physicalFluxShape, displayFluxProfile);
        rayInvariantPixels[pixelIndex].final = vec4(
            positiveAngularMomentumShift, negativeAngularMomentumShift,
            disk_rotation_sign, 0.0);
        float displayTemperature = clamp(localTemperature / 15000.0, 0.0, 1.0);
        imageStore(outImage, pix, vec4(displayTemperature, 0.0, 0.0, 1.0));
        return;
    }

    // Init Ray
    float u = (2.0 * (pix.x + 0.5) / WIDTH - 1.0) * cam.aspect * cam.tanHalfFov;
    float v = (1.0 - 2.0 * (pix.y + 0.5) / HEIGHT) * cam.tanHalfFov;
    vec3 dir = normalize(u * cam.camRight - v * cam.camUp + cam.camForward);
    Ray ray = initRay(cam.camPos, dir);
    if (integration.exportDiagnostics != 0) {
        rayInvariantPixels[pixelIndex].initial = rayInvariants(ray);
    }
    if (!ray.validCoordinates) {
        // Camera controls normally prevent this path.  Make any future
        // coordinate-chart violation explicit instead of manufacturing a
        // capture/shadow pixel.
        atomicAdd(rayStatusCounts[STATUS_INVALID], 1u);
        if (integration.exportDiagnostics != 0) {
            rayStatusPixels[pixelIndex] = uint(STATUS_INVALID);
            rayInvariantPixels[pixelIndex].final = vec4(0.0);
        }
        imageStore(outImage, pix, vec4(1.0, 0.0, 1.0, 1.0));
        return;
    }

    vec4 color = vec4(0.0);
    vec3 prevPos = vec3(ray.x, ray.y, ray.z);
    vec3 finalRayDirection = dir;
    vec3 diskHitPosition = vec3(0.0);
    float lambda = 0.0;
    float closestRadius = ray.r;
    float angularTravel = 0.0;

    int status = STATUS_UNRESOLVED;
    float suggestedStep = adaptiveStepSize(ray);

    // Keep the same integration budget while moving. Most rays terminate
    // early, while near-critical rays no longer change classification merely
    // because the camera is being dragged.
    int maxSteps = integration.maximumSteps;
    float escapeRadius = max(integration.escapeRadius, max(length(cam.camPos) * 2.5, disk_r2 * 8.0));
    float captureRadius = integration.captureRadius;

    for (int i = 0; i < maxSteps; ++i) {
        if (intercept(ray, captureRadius)) {
            status = STATUS_CAPTURED;
            break;
        }
        Ray previousRay = ray;
        float stepSize = min(suggestedStep, adaptiveStepSize(ray));
        float acceptedStep = 0.0;
        suggestedStep = stepSize;
        if (!adaptiveRK4Step(ray, suggestedStep, acceptedStep)) {
            status = STATUS_UNRESOLVED;
            break;
        }
        stepSize = acceptedStep;
        lambda += stepSize;

        if (!rayIsFinite(ray)) {
            status = STATUS_INVALID;
            break;
        }

        vec3 newPos = vec3(ray.x, ray.y, ray.z);
        if (any(isnan(newPos)) || any(isinf(newPos))) {
            status = STATUS_INVALID;
            break;
        }
        vec3 travel = newPos - prevPos;
        if (dot(travel, travel) > 0.0) finalRayDirection = normalize(travel);

        vec3 oldRadialDirection = normalize(prevPos);
        vec3 newRadialDirection = normalize(newPos);
        float angularIncrement = asin(clamp(
            length(cross(oldRadialDirection, newRadialDirection)), 0.0, 1.0));
        angularTravel += angularIncrement;
        closestRadius = min(closestRadius, ray.r);

        if (intersectAccretionDisk(prevPos, newPos, diskHitPosition)) {
            status = STATUS_DISK_HIT;
            break;
        }
        Ray horizonCrossing;
        bool crossedHorizon = interpolateHorizonCrossing(
            previousRay, ray, captureRadius, horizonCrossing);
        if (crossedHorizon || intercept(ray, captureRadius)) {
            if (crossedHorizon) ray = horizonCrossing;
            status = STATUS_CAPTURED;
            break;
        }
        prevPos = newPos;
        if (ray.r >= escapeRadius && ray.dr > 0.0) {
            status = STATUS_ESCAPED;
            break;
        }
    }

    atomicAdd(rayStatusCounts[status], 1u);
    if (integration.exportDiagnostics != 0) {
        rayStatusPixels[pixelIndex] = uint(status);
        if (rayIsFinite(ray)) {
            rayInvariantPixels[pixelIndex].final = rayInvariants(ray);
            rayInvariantPixels[pixelIndex].final.w = ray.r;
        } else {
            rayInvariantPixels[pixelIndex].final = vec4(0.0);
        }
    }
    if (status == STATUS_DISK_HIT) {
        vec3 diskColor = shadeAccretionDisk(
            diskHitPosition, ray, angularTravel, lambda);
        color = vec4(diskColor, 1.0);

    } else if (status == STATUS_CAPTURED) {
        color = vec4(0.0, 0.0, 0.0, 1.0);

    } else if (status == STATUS_ESCAPED) {
        color = integration.backgroundMode == 0
            ? vec4(spaceBackground(finalRayDirection), 1.0)
            : vec4(0.001, 0.001, 0.0015, 1.0);

    } else {
        // Numerical failure is never a shadow pixel.  Debug/validation builds
        // show an unmistakable color; release Physical mode uses a dark-blue
        // fallback that remains visibly distinct from capture.
        bool invalid = status == STATUS_INVALID;
        if (integration.validationOverlay != 0) {
            color = invalid ? vec4(1.0, 0.0, 1.0, 1.0)
                            : vec4(1.0, 1.0, 0.0, 1.0);
        } else {
            color = invalid ? vec4(0.25, 0.0, 0.25, 1.0)
                            : vec4(0.0, 0.03, 0.14, 1.0);
        }
    }

    if (integration.renderMode != 0 &&
        (status == STATUS_ESCAPED || status == STATUS_DISK_HIT)) {
        color.rgb += photonRingEmission(closestRadius, angularTravel);
    }

    color.rgb = integration.renderMode == 0
        ? color.rgb / (vec3(1.0) + color.rgb)
        : acesToneMap(color.rgb);

    imageStore(outImage, pix, color);
}
